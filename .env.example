# MLflow Configuration
# ═══════════════════════════════════════════════════════════════════

# OPTION 1: Remote MLflow Server (Recommended - for team collaboration)
# ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=yourname_mlflow_demo  # ⚠️ Use unique name!

# Remote Server Authentication (Required for remote server)
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_password

# OPTION 2: Local MLflow Server (Alternative - for testing only)
# ───────────────────────────────────────────────────────────────────
# Uncomment below and comment out remote config to use local server:
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=
# (No username/password needed for local)

# LLM Provider Configuration
# ═══════════════════════════════════════════════════════════════════
DEFAULT_LLM_PROVIDER=gemini
# Options: 'gemini' or 'openai'

# Gemini Configuration (Recommended - Default)
# ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
# Get your key from: https://aistudio.google.com/app/apikey

# OpenAI Configuration (Optional)
# ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (Optional)
# ───────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=

# Model Configuration
# ═══════════════════════════════════════════════════════════════════
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=150
DEFAULT_TOP_P=0.9

# ═══════════════════════════════════════════════════════════════════
# IMPORTANT NOTES:
# ═══════════════════════════════════════════════════════════════════
# 
# 1. For Remote Server (https://mlflow.shorthills.ai):
#    - All results stored on remote server
#    - No need to run 'mlflow ui' locally
#    - View results at: https://mlflow.shorthills.ai
#    - Use UNIQUE names (include your name/identifier)
#
# 2. For Local Server:
#    - Run: mlflow ui --port 5000
#    - View results at: http://localhost:5000
#    - Results stored locally
#
# 3. Testing Connection:
#    - Run: python test_remote_connection.py
#
# ═══════════════════════════════════════════════════════════════════
